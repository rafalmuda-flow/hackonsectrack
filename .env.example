# Copy to .env locally. Never commit credentials.
OM_AI_PROVIDER=openrouter
OM_AI_MODEL=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
APIFY_TOKEN=
OCTOLENS_API_KEY=
# Evaluation uses a real provider only when explicitly configured.
ACQUISITION_DATA_MODE=fixtures
ACQUISITION_RUN_BUDGET_USD=0.25
ACQUISITION_CAMPAIGN_BUDGET_USD=5.00
ACQUISITION_ALLOW_OUTBOUND=false
OM_BASE_URL=http://localhost:3000
OM_API_KEY=
